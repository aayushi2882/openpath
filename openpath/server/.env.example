# OpenPath backend configuration
PORT=5501

# Optional GitHub token for higher public API rate limits
GITHUB_TOKEN=

# Local Ollama inference. There is no hosted AI fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Optional browser navigation timeout (clamped between 8000 and 45000).
WEBSITE_ANALYSIS_TIMEOUT_MS=25000
# Install Chromium once for website capture with: npx playwright install chromium
