# OpenPath Server Environment Configuration

# Server Port (default 5000)
PORT=5000

# Optional GitHub Personal Access Token (PAT)
# Strongly recommended to avoid standard GitHub API rate limits (10 req/min unauthenticated vs 30-5,000 req/hr authenticated)
# Generate a free token at: https://github.com/settings/tokens (no special scopes needed for public repo search)
GITHUB_TOKEN=

# AI Provider Configuration
# Choose one of: 'gemini', 'openai', 'groq' (or leave empty to run in AI-disabled demo mode)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Provide the API key for your chosen provider:
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Generic OpenAI-compatible endpoint (optional, e.g. Ollama or local proxy)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
