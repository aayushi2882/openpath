# OpenPath Root Environment Configuration

# Optional: Custom backend API URL for frontend (default in dev is via Vite proxy to /api)
# VITE_API_BASE_URL=http://localhost:5000

# Backend environment variables can also be placed here or in server/.env
# See server/.env.example for details on GITHUB_TOKEN and AI_PROVIDER keys
PORT=5000
GITHUB_TOKEN=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
